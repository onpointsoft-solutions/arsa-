// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  role          Role       @default(USER)
  
  // Profile
  bio           String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  country       String?
  
  // Relationships
  properties    Property[]
  testimonials  Testimonial[]
  savedProperties SavedProperty[]
  messages      Message[]
  appointments  Appointment[]
  activityLogs  ActivityLog[]
  
  // Metadata
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  @@index([email])
  @@index([role])
}

model Property {
  id              String     @id @default(cuid())
  title           String
  description     String     @db.Text
  price           Float
  type            PropertyType
  status          PropertyStatus @default(AVAILABLE)
  
  // Location
  address         String
  city            String
  state           String
  zipCode         String
  country         String
  latitude        Float?
  longitude       Float?
  
  // Details
  bedrooms        Int
  bathrooms       Int
  squareFeet      Int
  yearBuilt       Int?
  
  // Media
  images          String[]   @default([])
  thumbnail       String?
  
  // Relationships
  categoryId      String
  category        Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  locationId      String
  location        Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  
  agentId         String
  agent           Agent      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  
  ownerId         String
  owner           User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  savedBy         SavedProperty[]
  messages        Message[]
  appointments    Appointment[]
  
  // Metadata
  featured        Boolean    @default(false)
  views           Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  @@index([categoryId])
  @@index([locationId])
  @@index([agentId])
  @@index([ownerId])
  @@index([status])
  @@fulltext([title, description, address, city])
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?    @db.Text
  icon        String?
  
  properties  Property[]
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
}

model Location {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?    @db.Text
  image       String?
  
  properties  Property[]
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
}

model Agent {
  id              String     @id @default(cuid())
  firstName       String
  lastName        String
  email           String     @unique
  phone           String
  avatar          String?
  bio             String?    @db.Text
  license         String?
  
  properties      Property[]
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  @@index([email])
}

model Testimonial {
  id          String     @id @default(cuid())
  content     String     @db.Text
  rating      Int        @default(5)
  
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  featured    Boolean    @default(false)
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([authorId])
}

model SavedProperty {
  id          String     @id @default(cuid())
  
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  propertyId  String
  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime   @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model Message {
  id          String     @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String
  body        String     @db.Text
  
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  propertyId  String?
  property    Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  
  status      MessageStatus @default(UNREAD)
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([propertyId])
  @@index([status])
}

model Appointment {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  propertyId  String
  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  scheduledAt DateTime
  status      AppointmentStatus @default(PENDING)
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([propertyId])
  @@index([status])
}

model Settings {
  id          String     @id @default(cuid())
  key         String     @unique
  value       String     @db.Text
  description String?
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([key])
}

model MediaFile {
  id          String     @id @default(cuid())
  url         String
  publicId    String?
  name        String
  type        String
  size        Int
  
  uploadedBy  String
  
  createdAt   DateTime   @default(now())
}

model ActivityLog {
  id          String     @id @default(cuid())
  action      String
  entity      String
  entityId    String
  changes     Json?
  
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime   @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// Enums
enum Role {
  ADMIN
  USER
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  TOWNHOUSE
  COMMERCIAL
  LAND
  OTHER
}

enum PropertyStatus {
  AVAILABLE
  SOLD
  RENTED
  PENDING
  ARCHIVED
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}
