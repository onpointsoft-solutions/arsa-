# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Public URL of this backend service on Render (no trailing slash)
# e.g. https://arsa-backend.onrender.com
API_URL=https://your-backend.onrender.com

# Public URL of the frontend static site on Render (no trailing slash)
# e.g. https://arsa-frontend.onrender.com
CLIENT_URL=https://your-frontend.onrender.com

# ─── Database (TiDB Cloud / PlanetScale / any MySQL) ─────────────────────────
# TiDB Cloud format (SSL auto-detected):
DATABASE_URL=mysql://user:password@host:4000/arsa_realestate

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=replace_with_another_64_char_random_hex
JWT_REFRESH_EXPIRE=30d

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ─── Cloudinary (optional — for persistent image uploads) ────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email / SMTP (optional) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@arsarealestate.com

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
